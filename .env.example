# dataStore namespaces used by the app.
# The DHIS2 App Platform (cli-app-scripts v12) only passes variables prefixed with DHIS2_.
DHIS2_DATA_SOURCES_STORE=DATA_SOURCES_STORE
DHIS2_DASHBOARD_STORE=DASHBOARD_STORE
DHIS2_VISUALS_STORE=VISUALS_STORE
DHIS2_MAPS_STORE=MAPS_STORE
DHIS2_BULLETIN_TEMPLATES_STORE=BULLETIN_TEMPLATES_STORE
DHIS2_BULLETIN_ISSUES_STORE=BULLETIN_ISSUES_STORE
# Optional: where "Import old bulletin texts" reads the texts of the old bulletin
# (defaults: epide-bulletin / epide).
# DHIS2_BULLETIN_STORE=epide-bulletin
# DHIS2_BULLETIN_TEMPLATE_KEY=epide
